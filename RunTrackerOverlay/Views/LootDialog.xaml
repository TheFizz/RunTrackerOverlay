<Window x:Class="RunTrackerOverlay.Views.LootDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Loot" Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E0000000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <Border BorderBrush="Gold" BorderThickness="1">
        <StackPanel Margin="10">
            <TextBlock Text="Enter loot details:" 
                       Foreground="White" 
                       Margin="0,0,0,10"
                       HorizontalAlignment="Left"/>
            
            <TextBox x:Name="LootInput"
                     Background="#40FFFFFF"
                     Foreground="White"
                     BorderBrush="Gold"
                     CaretBrush="White"
                     Margin="0,0,0,10"
                     Padding="5"
                     KeyDown="LootInput_KeyDown"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Cancel" Margin="5,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button Grid.Column="0" Content="Save" Margin="0,0,5,0" IsDefault="True" Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
