<Window x:Class="RunTrackerOverlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RunTrackerOverlay.Converters"
        Title="Run Tracker Overlay" MinWidth="20"
        SizeToContent="WidthAndHeight"
        Topmost="True" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{Binding BackgroundBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" Invert="True"/>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Border x:Name="WindowBorder" BorderBrush="Gold" BorderThickness="1" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False"/>
        
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,5,5">
            <!-- Top Links: Settings, Save, Reset, Close -->
            <StackPanel x:Name="TopLinksPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,-3,0">
                <TextBlock x:Name="OptionsLink"
                           Text="⚙"
                           Foreground="Gold"
                           FontSize="12"
                           FontFamily="Consolas"
                           Cursor="Hand"
                           Width="18"
                           TextAlignment="Center">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OptionsCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock Text="|" Foreground="Gray" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock x:Name="SaveLink"
                           Text="🖫"
                           Foreground="LimeGreen"
                           FontSize="12"
                           FontFamily="Consolas"
                           Cursor="Hand"
                           Width="18"
                           TextAlignment="Center">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SaveCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock Text="|" Foreground="Gray" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock x:Name="ResetLink"
                           Text="⭮"
                           Foreground="Orange"
                           FontSize="12"
                           FontFamily="Consolas"
                           Cursor="Hand"
                           Width="18"
                           TextAlignment="Center">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ResetCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock Text="|" Foreground="Gray" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock x:Name="CloseLink"
                           Text="✖"
                           Foreground="Red"
                           FontSize="12"
                           FontFamily="Consolas"
                           Cursor="Hand"
                           Width="18"
                           TextAlignment="Center">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>

            <TextBlock x:Name="SessionLabel" 
                       Text="{Binding SessionName}" 
                       Foreground="LightSteelBlue" 
                       FontSize="18" 
                       FontFamily="Consolas"
                       Opacity="{Binding TextOpacity}"
                       Margin="3,0,0,0"
                       Visibility="{Binding ShowSessionNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="RunStatus" 
                           Text="{Binding RunStatusSymbol}" 
                           Foreground="{Binding RunStatusForeground}" 
                           FontSize="14" 
                           FontFamily="Consolas"
                           Width="17"
                           TextAlignment="Center"
                           Opacity="{Binding TextOpacity}"/>
                <TextBlock x:Name="RunLabel" 
                           Text="{Binding RunLabelText}" 
                           Foreground="LightSteelBlue" 
                           FontSize="14" 
                           FontFamily="Consolas"
                           Opacity="{Binding TextOpacity}"/>
            </StackPanel>
            <TextBlock x:Name="TimerText" 
                       Text="{Binding TimerText}" 
                       Foreground="{Binding TimerForeground}" 
                       FontSize="30" 
                       FontWeight="Bold"
                       FontFamily="Consolas"
                       HorizontalAlignment="Left"
                       Margin="0,-2,0,0"
                       Opacity="{Binding TextOpacity}"/>

            <Grid Margin="0,0,0,5" Visibility="{Binding ShowStats, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Best: " Foreground="White" FontSize="12" FontFamily="Consolas" Margin="0,0,5,0" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowBest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BestRunText" Text="{Binding BestTimeText}" Foreground="Gold" FontSize="12" FontFamily="Consolas" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowBest, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Last: " Foreground="White" FontSize="12" FontFamily="Consolas" Margin="0,0,5,0" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowLast, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastRunText" Text="{Binding LastRunTimeText}" Foreground="White" FontSize="12" FontFamily="Consolas" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowLast, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Worst: " Foreground="White" FontSize="12" FontFamily="Consolas" Margin="0,0,5,0" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowWorst, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="WorstRunText" Text="{Binding WorstTimeText}" Foreground="IndianRed" FontSize="12" FontFamily="Consolas" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowWorst, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Avg: " Foreground="White" FontSize="12" FontFamily="Consolas" Margin="0,0,5,0" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowAvg, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AverageRunText" Text="{Binding AverageTimeText}" Foreground="DarkGray" FontSize="12" FontFamily="Consolas" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowAvg, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Total: " Foreground="White" FontSize="12" FontFamily="Consolas" Margin="0,0,5,0" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowTotal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TotalRunText" Text="{Binding TotalTimeText}" Foreground="Gray" FontSize="12" FontFamily="Consolas" Opacity="{Binding TextOpacity}" Visibility="{Binding ShowTotal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
            
            <TextBlock x:Name="KeysTooltip"
                       Text="{Binding TooltipText}"
                       Visibility="{Binding ShowTooltip, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="Gray"
                       FontSize="10"
                       FontFamily="Consolas"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,0"
                       Opacity="{Binding TextOpacity}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>